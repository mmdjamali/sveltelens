{
  "name": "sveltecope-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:dashboard": "cd packages/dashboard && bun run build",
    "build:package": "cd packages/telescope && bun run build",
    "build": "bun run build:dashboard && bun run build:package",
    "dev:demo": "cd examples/demo-app && bun run dev",
    "test": "cd packages/telescope && bun run test"
  },
  "devDependencies": {
    "node-gyp": "^11.0.0",
    "typescript": "^5.6.3"
  }
}
