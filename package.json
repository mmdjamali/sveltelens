{
  "name": "sveltelens-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:dashboard": "cd packages/dashboard && bun run build",
    "build:package": "cd packages/sveltelens && bun run build",
    "build:docs": "cd packages/docs && bun run build",
    "build": "bun run build:dashboard && bun run build:package && bun run build:docs",
    "dev:demo": "cd examples/demo-app && bun run dev",
    "dev:docs": "cd packages/docs && bun run dev",
    "test:package": "cd packages/sveltelens && bun run test",
    "test:dashboard": "cd packages/dashboard && bun run test",
    "test": "bun run test:package && bun run test:dashboard",
    "lint": "biome lint .",
    "check:package": "cd packages/sveltelens && bun run check",
    "check:dashboard": "cd packages/dashboard && bun run check",
    "check:demo": "cd examples/demo-app && bun run check",
    "check": "bun run check:package && bun run check:dashboard && bun run check:demo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "node-gyp": "^11.0.0",
    "typescript": "^5.6.3"
  }
}
