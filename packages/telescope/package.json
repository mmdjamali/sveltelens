{
  "name": "sveltecope",
  "version": "0.1.0",
  "description": "Laravel Telescope-style local developer observability dashboard for SvelteKit",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "dashboard-dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hook": {
      "types": "./dist/hook.d.ts",
      "import": "./dist/hook.js",
      "require": "./dist/hook.cjs"
    },
    "./adapters/drizzle": {
      "types": "./dist/adapters/drizzle.d.ts",
      "import": "./dist/adapters/drizzle.js",
      "require": "./dist/adapters/drizzle.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "sirv": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.15.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^11.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "undici": "^7.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
