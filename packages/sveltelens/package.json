{
  "name": "sveltelens",
  "version": "0.1.0",
  "description": "Laravel Telescope-style local developer observability dashboard for SvelteKit",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "dashboard-dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hook": {
      "types": "./dist/hook.d.ts",
      "import": "./dist/hook.js",
      "require": "./dist/hook.cjs"
    },
    "./adapters/sqlite": {
      "types": "./dist/adapters/sqlite.d.ts",
      "import": "./dist/adapters/sqlite.js",
      "require": "./dist/adapters/sqlite.cjs"
    },
    "./adapters/pg": {
      "types": "./dist/adapters/pg.d.ts",
      "import": "./dist/adapters/pg.js",
      "require": "./dist/adapters/pg.cjs"
    },
    "./adapters/mysql2": {
      "types": "./dist/adapters/mysql2.d.ts",
      "import": "./dist/adapters/mysql2.js",
      "require": "./dist/adapters/mysql2.cjs"
    },
    "./adapters/libsql": {
      "types": "./dist/adapters/libsql.d.ts",
      "import": "./dist/adapters/libsql.js",
      "require": "./dist/adapters/libsql.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "sirv": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.15.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@libsql/client": "^0.17.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/pg": "^8.11.10",
    "better-sqlite3": "^11.0.0",
    "mysql2": "^3.23.2",
    "pg": "^8.13.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "undici": "^7.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
